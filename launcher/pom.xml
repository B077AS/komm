<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>komm</groupId>
    <artifactId>komm-launcher</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <name>komm-launcher</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>27.0.1</javafx.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- override with -Dlauncher.demo=true to run the scripted demo -->
        <launcher.demo>false</launcher.demo>
        <jpack.api.version>0.1.0</jpack.api.version>
        <!-- Fixed jar entry timestamps: the same sources give the same bytes, so the launcher part
             of a release keeps its hash (and is not downloaded again) until the launcher changes. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.kordamp.ikonli/ikonli-javafx -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.4.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.kordamp.ikonli/ikonli-feather-pack -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>12.4.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.github.mkpaz/atlantafx-base -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/net.java.dev.jna/jna -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/net.java.dev.jna/jna-platform -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.0</version>
        </dependency>
        <!-- The connection to the jpack stub that started the launcher: check, download with
             progress, hand over to the client. Dependency-free; works from Java 17. -->
        <dependency>
            <groupId>io.github.b077as</groupId>
            <artifactId>jpack-api</artifactId>
            <version>${jpack.api.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/ch.qos.logback/logback-classic -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.4</version>
        </dependency>
    </dependencies>

    <!-- mvn javafx:run                          (dev run - no jpack stub, so it only previews the UI)
         mvn javafx:run -Dlauncher.demo=true     (scripted demo of every phase)
         mvn clean package -Pwin-natives         (target/komm-launcher.jar with Windows JavaFX natives)
         mvn clean package -Plinux-natives       (target/komm-launcher.jar with Linux JavaFX natives)

         The two single-platform fat jars are what the client's `jpack` profile packages as the
         launcher part of a release (see ../src/jpack/jpack.json); the installer and the AppImage
         are produced from there, not from this project. -->
    <profiles>
        <profile>
            <id>win-natives</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>linux-natives</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <!-- Pinned (not the artifactId-version default) so the jar has the same name in every build. -->
        <finalName>komm-launcher</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Shared with the client (single source of truth for the look): the
                 komm-theme.css patch over AtlantaFX's Dracula, its fonts, and the icon. -->
            <resource>
                <directory>${project.basedir}/../src/main/resources</directory>
                <includes>
                    <include>komm-theme.css</include>
                    <include>fonts/**</include>
                    <include>icon.png</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Compiles the client's theme classes (KommStylesheet builds the patched
                 user-agent stylesheet, AppTheme holds the accent palettes) and its logback
                 level colouring straight from ../src/main/java instead of copying them.
                 The compiler <includes> below restrict that extra root to exactly these. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-shared-client-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>komm.launcher.Launcher</mainClass>
                    <options>
                        <option>-Dlauncher.demo=${launcher.demo}</option>
                        <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>25</release>
                    <includes>
                        <include>komm/launcher/**/*.java</include>
                        <include>komm/ui/theme/KommStylesheet.java</include>
                        <include>komm/ui/theme/AppTheme.java</include>
                        <include>komm/utils/CustomDebugConfig.java</include>
                    </includes>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>komm.launcher.Launcher</mainClass>
                                    <manifestEntries>
                                        <!-- JEP 472: JavaFX/JNA native access without warnings (fat jar = unnamed module). -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

