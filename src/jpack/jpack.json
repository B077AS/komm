{
  "name": "Komm",
  "mainClass": "komm.Launcher",

  "updateUrl": "https://github.com/B077AS/komm/releases/latest/download",
  "policy": "manual",

  "archive": false,

  "addModules": "jdk.management,jdk.net",

  "jvmArgs": [
    "-Xms32m",
    "-Xmx2g",
    "-XX:G1PeriodicGCInterval=30000",
    "-XX:MinHeapFreeRatio=10",
    "-XX:MaxHeapFreeRatio=20",
    "-XX:ParallelGCThreads=2",
    "-XX:ConcGCThreads=1",
    "-XX:MaxDirectMemorySize=1g",
    "-XX:+UseCompactObjectHeaders",
    "--enable-native-access=ALL-UNNAMED"
  ],

  "env": {
    "MALLOC_ARENA_MAX": "2"
  },

  "branding": {
    "icon": "src/jpack/icon.ico",
    "description": "Komm",
    "company": "Komm",
    "product": "Komm"
  },

  "launcher": {
    "jar": "launcher/target/komm-launcher.jar",
    "mainClass": "komm.launcher.Launcher",
    "jvmArgs": [
      "-XX:+UseSerialGC",
      "-Xms8m",
      "-Xmx128m",
      "-XX:TieredStopAtLevel=1",
      "--enable-native-access=ALL-UNNAMED"
    ]
  }
}
